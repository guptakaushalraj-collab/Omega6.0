node_modules/
dist/
build/

# Runtime data — regenerated by `npm run seed` / created on first request
backend/src/data/db.json
backend/uploads/*
!backend/uploads/.gitkeep

# Module runtime data — each module creates its own store on first request
modules/*/src/data/
modules/*/uploads/*
!modules/*/uploads/.gitkeep

*.log
.DS_Store

# Secrets — real .env files at ANY depth (root and every module).
# .env.example files are templates with development-only defaults and ARE
# tracked; the negation below keeps them that way.
.env
.env.local
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
hacquire/modules/*/app/data/
hacquire/modules/*/app/uploads/
