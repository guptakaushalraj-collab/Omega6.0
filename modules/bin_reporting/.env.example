# bin_reporting — environment
#
# Copy to .env and adjust:  cp .env.example .env
# Real environment variables take precedence over this file.

# Port to listen on.
PORT=4101

# ---------------------------------------------------------------------------
# OPTIONAL DEPENDENCIES
#
# All three are OPTIONAL. With none set, this module is a self-contained bin
# intake log — still useful, and the minimum a buyer gets with no other
# purchase. Each is a capability, not a fixed vendor: point it at any
# conforming provider.
#
# A report is ALWAYS persisted before these are called, so a citizen's
# submission is never lost to a downstream outage. Whatever fails, the
# response's `degraded` object names it.
# ---------------------------------------------------------------------------

# waste.classify — identifies waste type from the uploaded photo.
# If unset/unreachable: the report is stored unclassified (waste_type: null).
# Recover later with POST /api/v1/reports/:id/reclassify.
WASTE_RECOGNITION_URL=http://localhost:4102

# workforce.dispatch — assigns the nearest available worker.
# If unset/unreachable: the report stays status "reported" and can be
# dispatched later.
WORKER_DASHBOARD_URL=http://localhost:4106

# Bearer token for WORKER_DASHBOARD_URL. Must match that service's
# CREW_AUTH_TOKEN.
CREW_AUTH_TOKEN=dev-fieldops-token

# analytics.ingest — operational event stream.
# If unset/unreachable: the report still succeeds; metrics lose a data point.
ANALYTICS_URL=http://localhost:4104

# Hard timeout for every outbound dependency call, in milliseconds.
# Note this bounds INTAKE latency, which a citizen is waiting on — keep it
# tight rather than generous.
DEPENDENCY_TIMEOUT_MS=2500
