# analytics_dashboard — environment
#
# Copy to .env and adjust:  cp .env.example .env
# Real environment variables take precedence over this file.
#
# This module has NO outbound dependencies — it is push-based and derives
# everything from events it is sent.

# Port to listen on.
PORT=4104

# Events retained before oldest-first eviction.
#
# NOTE: derived metrics reflect the retention window, not all time. Once
# eviction begins, totals.reported counts only what is still retained. Raise
# this, or mirror the event stream into a warehouse, if you need durable
# history for reporting or compliance.
MAX_EVENTS=20000
