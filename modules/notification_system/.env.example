# notification_system (ACQUIRED — SignalPost Relay 2.4.1) — environment
#
# Copy to .env and adjust:  cp .env.example .env
# Real environment variables take precedence over this file.
#
# This module has NO outbound dependencies.

# Port to listen on.
PORT=4105

# API key callers must present as the `X-API-Key` header.
#
# SECURITY: the value below is a DEVELOPMENT DEFAULT and is public knowledge —
# it is the fallback baked into src/server.js. Change it before exposing this
# service on any network you do not fully control. Every caller must be
# updated with the same value (worker_dashboard reads it as NOTIFY_API_KEY).
NOTIFY_API_KEY=dev-signalpost-key

# Messages retained before oldest-first eviction.
MAX_MESSAGES=10000

# ---------------------------------------------------------------------------
# NOT INCLUDED IN THE ACQUISITION
#
# Only the `in_app` channel actually delivers. `sms`, `email` and `push` are
# accepted and recorded with delivery_status "queued", but nothing sends them:
# the SignalPost gateway credentials that fulfil those channels were not part
# of the acquisition.
#
# To activate them, obtain a commercial agreement with SignalPost or wire your
# own provider into the send path in src/server.js. The variables such an
# integration would need are listed here as a placeholder — they are NOT read
# by the current build, and setting them has no effect today.
#
# SIGNALPOST_GATEWAY_URL=
# SIGNALPOST_GATEWAY_KEY=
# ---------------------------------------------------------------------------
