# worker_dashboard (ACQUIRED — FieldOps Crew 3.1.0) — environment
#
# Copy to .env and adjust:  cp .env.example .env
# Real environment variables take precedence over this file.

# Port to listen on.
PORT=4106

# Bearer token callers must present as `Authorization: Bearer <token>`.
#
# SECURITY: a DEVELOPMENT DEFAULT and public knowledge — it is the fallback
# baked into src/server.js. Change it before exposing this service. Every
# caller must be updated with the same value (bin_reporting reads it as
# CREW_AUTH_TOKEN).
CREW_AUTH_TOKEN=dev-fieldops-token

# ---------------------------------------------------------------------------
# OPTIONAL DEPENDENCIES
#
# All three are OPTIONAL. Leave any unset and the module still runs — the
# associated feature degrades rather than fails. Each is a capability, not a
# fixed vendor: point it at any conforming provider, including a competitor's
# hosted endpoint or your own reimplementation.
# ---------------------------------------------------------------------------

# route.optimize — sequences a worker's open jobs.
# If unset/unreachable: GET /v1/workers/:id/queue returns stops UNORDERED with
# `optimized: false` and a `degraded_reason`. The worker still sees their queue.
ROUTE_OPTIMIZER_URL=http://localhost:4103

# notify.send — worker/citizen/admin alerts.
# If unset/unreachable: assignment and completion still succeed; the alert is
# skipped and reported in the response's `side_effects`.
NOTIFICATION_URL=http://localhost:4105

# API key for NOTIFICATION_URL. Must match that service's NOTIFY_API_KEY.
NOTIFY_API_KEY=dev-signalpost-key

# analytics.ingest — operational event stream.
# If unset/unreachable: assignment and completion still succeed; metrics lose
# a data point.
ANALYTICS_URL=http://localhost:4104

# Hard timeout for every outbound dependency call, in milliseconds.
# Bounds worst-case response time: a slow dependency must not become a slow
# response. Raise only if a provider is genuinely far away on the network.
DEPENDENCY_TIMEOUT_MS=2500
