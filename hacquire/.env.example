# Intelligent Waste Collection Network — HACQUIRE 2026
#
# Copy to .env and edit. `main.py` reads this file, but ONLY for keys not
# already set in the environment — an exported value or a container platform's
# injection always wins over a checked-in default.
#
# EVERY VALUE HERE HAS A WORKING DEFAULT. `python main.py` runs the whole
# network with no .env at all; this file exists to change ports, rotate
# credentials, or repoint a module at someone else's host.

# ---------------------------------------------------------------- topology
HOST=0.0.0.0
# How the modules address EACH OTHER. Change to a service name under
# docker-compose / Kubernetes.
SERVICE_HOST=localhost

BIN_REPORTING_PORT=8001
WASTE_RECOGNITION_PORT=8002
ROUTE_OPTIMIZER_PORT=8003
ANALYTICS_DASHBOARD_PORT=8004
NOTIFICATION_SYSTEM_PORT=8005
WORKER_DASHBOARD_PORT=8006
CHAT_ASSISTANT_PORT=8007

# ------------------------------------------------------------ credentials
# SECURITY: both defaults below are PUBLIC KNOWLEDGE — they are the fallbacks
# baked into the module source so a fresh clone runs. Change them before
# exposing any service beyond localhost.

# notification_system (SignalPost Relay) — presented as the X-API-Key header.
# worker_dashboard reads the SAME variable name to call it.
NOTIFY_API_KEY=dev-signalpost-key

# worker_dashboard (FieldOps Crew) — presented as `Authorization: Bearer`.
# bin_reporting and chat_assistant read the SAME variable name to call it.
CREW_AUTH_TOKEN=dev-fieldops-token

# chat_assistant (Suvida Chatbot) — presented as the X-API-Key header.
# The acquired code read os.getenv("API_KEY") with no fallback, which made the
# check fail OPEN when unset. It now falls back to this documented default and
# rejects a missing header outright, so it fails closed either way.
CHAT_API_KEY=dev-suvida-key

# ------------------------------------------------------------ dependencies
# Each module consumes CAPABILITIES, never named modules, and reaches them at
# a URL. Leave these unset and main.py points each one at the local process;
# set one and that module is repointed — this single indirection is what lets
# a SOLD module keep serving us from the buyer's infrastructure with no code
# change on either side.
#
# WASTE_RECOGNITION_URL=https://classify.buyer-hosted.example
# ROUTE_OPTIMIZER_URL=https://routing.buyer-hosted.example
# ANALYTICS_DASHBOARD_URL=https://metrics.buyer-hosted.example
# NOTIFICATION_SYSTEM_URL=http://localhost:8005
# WORKER_DASHBOARD_URL=http://localhost:8006

# Hard timeout on every outbound call. A slow dependency must never become a
# slow response — bounds citizen-facing intake latency in particular.
DEPENDENCY_TIMEOUT_MS=2500

# --------------------------------------------------------- chat assistant
# OPTIONAL LLM. Leave unset and the assistant answers from templates —
# deterministic, offline, and exactly as accurate, just less chatty. Set it and
# replies are rephrased by a local model; the facts still come from the
# modules, never from the model.
#
# Requires Ollama running locally with the model pulled:
#     ollama serve && ollama pull llama3.2:3b
# OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Separate, longer budget than DEPENDENCY_TIMEOUT_MS: token generation is slow
# and a person waiting on a chat reply tolerates more latency than the intake
# API does. Still bounded — an unbounded generate call is how a chat endpoint
# hangs forever.
LLM_TIMEOUT_MS=20000

# --------------------------------------------------------------- retention
# analytics_dashboard: events kept before oldest-first eviction. Derived
# metrics reflect this window, not all time.
MAX_EVENTS=20000

# notification_system: messages kept before oldest-first eviction.
MAX_MESSAGES=10000

# NOT INCLUDED IN THE ACQUISITION -------------------------------------------
# notification_system delivers `in_app` only. sms/email/push are accepted and
# recorded as "queued" but nothing sends them — the SignalPost gateway
# credentials were not part of the asset purchase. Listed as a placeholder;
# NOT read by this build.
# SIGNALPOST_GATEWAY_URL=
# SIGNALPOST_GATEWAY_KEY=
