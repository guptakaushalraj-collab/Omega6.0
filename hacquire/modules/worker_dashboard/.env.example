# worker_dashboard — BOUGHT (FieldOps Crew 3.1.0)
PORT=8006

# Bearer token callers must present.
# SECURITY: public knowledge — change before exposing. bin_reporting reads the
# same variable name.
CREW_AUTH_TOKEN=dev-fieldops-token

# OPTIONAL DEPENDENCIES — all three degrade rather than fail when unset.
# Each is a CAPABILITY, not a fixed vendor: point at any conforming provider,
# including a buyer's hosted endpoint.

# route.optimize — if absent, /v1/workers/{id}/queue returns stops UNORDERED
# with optimized:false and a degraded_reason.
ROUTE_OPTIMIZER_URL=http://localhost:8003

# notify.send — if absent, assignment/completion still succeed; the alert is
# skipped and reported in side_effects.
NOTIFICATION_URL=http://localhost:8005
NOTIFY_API_KEY=dev-signalpost-key

# analytics.ingest — if absent, metrics lose a data point.
ANALYTICS_URL=http://localhost:8004

# Hard timeout per outbound call. A slow dependency must not become a slow
# response.
DEPENDENCY_TIMEOUT_MS=2500
