# notification_system — BOUGHT (SignalPost Relay 2.4.1)
PORT=8005

# Key callers present as the X-API-Key header.
# SECURITY: this default is PUBLIC KNOWLEDGE — it is the fallback baked into
# app/main.py. Change it before exposing this service, and update every caller
# (worker_dashboard reads the same variable name).
NOTIFY_API_KEY=dev-signalpost-key

MAX_MESSAGES=10000

# NOT INCLUDED IN THE ACQUISITION -------------------------------------------
# Only in_app delivers. sms/email/push are accepted and recorded as "queued"
# but nothing sends them — the SignalPost gateway credentials were not part of
# the asset purchase. The variables such an integration would need are listed
# below as a placeholder; they are NOT read by this build.
# SIGNALPOST_GATEWAY_URL=
# SIGNALPOST_GATEWAY_KEY=
