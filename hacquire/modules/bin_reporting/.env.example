# bin_reporting — HELD (not for sale)
PORT=8001

# OPTIONAL DEPENDENCIES — with none set this module is a self-contained bin
# intake log, which is the minimum a buyer gets with no other purchase.
# A report is ALWAYS persisted before these are called, so a citizen's
# submission is never lost to a downstream outage.

# waste.classify — if absent, the report is stored unclassified; recover via
# POST /api/v1/reports/{id}/reclassify.
WASTE_RECOGNITION_URL=http://localhost:8002

# workforce.dispatch — if absent, the report stays "reported" and can be
# dispatched later.
WORKER_DASHBOARD_URL=http://localhost:8006
CREW_AUTH_TOKEN=dev-fieldops-token

# analytics.ingest — if absent, the report still succeeds.
ANALYTICS_URL=http://localhost:8004

# Bounds INTAKE latency, which a citizen is actively waiting on — keep tight.
DEPENDENCY_TIMEOUT_MS=2500
