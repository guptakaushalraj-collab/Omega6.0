# Omega6.0 — root environment
#
# Copy to .env and adjust:  cp .env.example .env
#
# This file covers values used by the orchestration scripts in scripts/, which
# run the whole module mesh locally. Each module ALSO has its own
# .env.example for standalone operation — see modules/<name>/.env.example.
# A module's own .env is what matters when you run it directly; this file
# matters when you run the mesh via `npm run modules:start`.

# ---------------------------------------------------------------------------
# SHARED SECRETS
#
# These are shared between a service and its callers, so they must match on
# both sides:
#
#   NOTIFY_API_KEY   notification_system  <-  worker_dashboard
#   CREW_AUTH_TOKEN  worker_dashboard     <-  bin_reporting
#
# SECURITY: both values below are DEVELOPMENT DEFAULTS and public knowledge —
# they are the fallbacks baked into the source. Change both before running
# anywhere other than a trusted local machine.
# ---------------------------------------------------------------------------

NOTIFY_API_KEY=dev-signalpost-key
CREW_AUTH_TOKEN=dev-fieldops-token

# ---------------------------------------------------------------------------
# INTEGRATED APP (backend/ + frontend/)
#
# The single-process packaging. Unrelated to the module mesh above; the two
# are alternative packagings of the same product and are not run together.
# ---------------------------------------------------------------------------

# Port for the integrated Express API in backend/.
# The Vite dev server proxies /api and /uploads here — change both together
# (see frontend/vite.config.js) if you move it.
PORT=4000
